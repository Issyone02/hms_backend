// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────────

enum RoomType {
  STANDARD
  DELUXE
  FAMILY
  BUSINESS
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  UNDER_MAINTENANCE
  CLEANING
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum HousekeepingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ServiceStatus {
  PENDING
  IN_PROGRESS
  FULFILLED
  CANCELLED
}

enum ChargeCategory {
  ROOM_RATE
  ROOM_SERVICE
  TAX
  DISCOUNT
  OTHER
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  CHECK_IN_REMINDER
  CHECK_OUT_REMINDER
  PAYMENT_RECEIPT
}

enum PaymentMethod {
  CREDIT_CARD
  CHEQUE
  CASH
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
  FAILED
}

enum StaffRole {
  RECEPTIONIST
  HOUSEKEEPING
  MANAGER
}

// ── Models ─────────────────────────────────────────────────────────────────────

model Hotel {
  id        String   @id @default(uuid())
  name      String
  address   String
  currency  String   @default("GBP")
  taxRate   Decimal  @default(0.20) @map("tax_rate") @db.Decimal(5,4)
  createdAt DateTime @default(now()) @map("created_at")

  rooms     Room[]
  staff     Staff[]

  @@map("hotels")
}

model Guest {
  id             String        @id @default(uuid())
  firstName      String        @map("first_name")
  lastName       String        @map("last_name")
  email          String        @unique
  phone          String?
  passwordHash   String        @map("password_hash")
  paymentMethod  PaymentMethod? @map("payment_method")
  gdprConsent    Boolean       @default(false) @map("gdpr_consent")
  createdAt      DateTime      @default(now()) @map("created_at")
  deletedAt      DateTime?     @map("deleted_at")

  bookings       RoomBooking[]
  notifications  Notification[]

  @@map("guests")
}

model Staff {
  id           String    @id @default(uuid())
  hotelId      String    @map("hotel_id")
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         StaffRole
  hiredDate    DateTime  @map("hired_date") @db.Date
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")

  hotel            Hotel             @relation(fields: [hotelId], references: [id])
  housekeepingLogs HousekeepingLog[]
  bookingsCreated  RoomBooking[]     @relation("CreatedBy")

  @@map("staff")
}

model Room {
  id            String     @id @default(uuid())
  hotelId       String     @map("hotel_id")
  roomNumber    String     @map("room_number")
  style         RoomType
  status        RoomStatus @default(AVAILABLE)
  pricePerNight Decimal    @map("price_per_night") @db.Decimal(10,2)
  capacity      Int        @default(2)
  createdAt     DateTime   @default(now()) @map("created_at")

  hotel            Hotel             @relation(fields: [hotelId], references: [id])
  bookings         RoomBooking[]
  roomKeys         RoomKey[]
  housekeepingLogs HousekeepingLog[]

  @@unique([hotelId, roomNumber])
  @@map("rooms")
}

model RoomBooking {
  id            String        @id @default(uuid())
  guestId       String        @map("guest_id")
  roomId        String        @map("room_id")
  checkInDate   DateTime      @map("check_in_date") @db.Date
  checkOutDate  DateTime      @map("check_out_date") @db.Date
  bookingStatus BookingStatus @default(PENDING) @map("booking_status")
  createdById   String?       @map("created_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  guest           Guest                @relation(fields: [guestId], references: [id])
  room            Room                 @relation(fields: [roomId], references: [id])
  createdBy       Staff?               @relation("CreatedBy", fields: [createdById], references: [id])
  serviceRequests RoomServiceRequest[]
  invoiceItems    InvoiceItem[]
  payment         Payment?

  @@map("room_bookings")
}

model RoomKey {
  id        String    @id @default(uuid())
  roomId    String    @map("room_id")
  barcode   String    @unique
  isActive  Boolean   @default(false) @map("is_active")
  issuedAt  DateTime? @map("issued_at")

  room Room @relation(fields: [roomId], references: [id])

  @@map("room_keys")
}

model HousekeepingLog {
  id             String             @id @default(uuid())
  roomId         String             @map("room_id")
  assignedStaffId String            @map("assigned_staff_id")
  scheduledDate  DateTime           @map("scheduled_date") @db.Date
  completedAt    DateTime?          @map("completed_at")
  notes          String?
  status         HousekeepingStatus @default(PENDING)
  createdAt      DateTime           @default(now()) @map("created_at")

  room          Room  @relation(fields: [roomId], references: [id])
  assignedStaff Staff @relation(fields: [assignedStaffId], references: [id])

  @@unique([roomId, scheduledDate])
  @@map("housekeeping_logs")
}

model RoomServiceRequest {
  id             String        @id @default(uuid())
  bookingId      String        @map("booking_id")
  serviceDetails String        @map("service_details")
  requestedAt    DateTime      @default(now()) @map("requested_at")
  status         ServiceStatus @default(PENDING)

  booking RoomBooking @relation(fields: [bookingId], references: [id])

  @@map("room_service_requests")
}

model InvoiceItem {
  id          String         @id @default(uuid())
  bookingId   String         @map("booking_id")
  description String
  amount      Decimal        @db.Decimal(10,2)
  chargeDate  DateTime       @default(now()) @map("charge_date")
  category    ChargeCategory

  booking RoomBooking @relation(fields: [bookingId], references: [id])

  @@map("invoice_items")
}

model Payment {
  id         String        @id @default(uuid())
  bookingId  String        @unique @map("booking_id")
  amount     Decimal       @db.Decimal(10,2)
  method     PaymentMethod
  paidAt     DateTime?     @map("paid_at")
  status     PaymentStatus @default(PENDING)
  gatewayRef String?       @map("gateway_ref")

  booking RoomBooking @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

model Notification {
  id             String           @id @default(uuid())
  guestId        String           @map("guest_id")
  message        String
  type           NotificationType
  sentAt         DateTime         @default(now()) @map("sent_at")
  isRead         Boolean          @default(false) @map("is_read")

  guest Guest @relation(fields: [guestId], references: [id])

  @@map("notifications")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id")
  actorRole  String?  @map("actor_role")
  action     String
  entity     String?
  entityId   String?  @map("entity_id")
  ipAddress  String?  @map("ip_address")
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@map("audit_log")
}
