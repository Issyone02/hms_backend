# Copy this file to .env and fill in your values
# NEVER commit .env to Git

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hms_db"
JWT_SECRET="replace-with-a-long-random-string-minimum-32-chars"
JWT_REFRESH_SECRET="another-long-random-string-for-refresh-tokens"
PORT=3000
NODE_ENV=development

# Optional: SendGrid for email notifications
SENDGRID_API_KEY="SG.xxxxxx"
SENDGRID_FROM_EMAIL="no-reply@yourhotel.com"
